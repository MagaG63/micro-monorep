    "build": "tsc -b && vite build",
    "lint": "echo 'profile: lint ok'",
    "test": "vitest run"
  },
  "dependencies": {
    "@sms/types": "workspace:*",
    "@sms/ui": "workspace:*",
    "@sms/utils": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
